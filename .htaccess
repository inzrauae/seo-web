# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/webseo1/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/webseo1/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# ================================================
# WEBSITE CONFIGURATION FOR CPANEL
# ================================================

# Disable Directory Listing
Options -Indexes

# ================================================
# HOST / PROTOCOL CANONICALIZATION
# Canonical tags site-wide use bare https://seoconsultantsrilanka.com
# ================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.seoconsultantsrilanka\.com$ [NC]
    RewriteRule ^ https://seoconsultantsrilanka.com%{REQUEST_URI} [R=301,L]
</IfModule>

# ================================================
# RETIRED PAGE REDIRECTS (301)
# Keep above the extension-removal block so these fire first.
# ================================================
Redirect 301 /seo-service-in-sri-lanka.html https://seoconsultantsrilanka.com/seo-sri-lanka
Redirect 301 /seo-service-in-sri-lanka https://seoconsultantsrilanka.com/seo-sri-lanka
Redirect 301 /best-seo-company-sri-lanka.html https://seoconsultantsrilanka.com/seo-company-sri-lanka
Redirect 301 /best-seo-company-sri-lanka https://seoconsultantsrilanka.com/seo-company-sri-lanka
Redirect 301 /seo-service-sri-lanka.html https://seoconsultantsrilanka.com/contact
Redirect 301 /seo-service-sri-lanka https://seoconsultantsrilanka.com/contact
Redirect 301 /seoservice-lk-sri-lanka.html https://seoconsultantsrilanka.com/seo-company-sri-lanka
Redirect 301 /seoservice-lk-sri-lanka https://seoconsultantsrilanka.com/seo-company-sri-lanka
Redirect 301 /pricing.html https://seoconsultantsrilanka.com/contact
Redirect 301 /pricing https://seoconsultantsrilanka.com/contact

# Town-level redirects (these towns are not standalone districts; they route
# to the nearest district/hub page instead of getting their own page)
Redirect 301 /seo-consultant-bandarawela.html https://seoconsultantsrilanka.com/seo-consultant-badulla
Redirect 301 /seo-consultant-bandarawela https://seoconsultantsrilanka.com/seo-consultant-badulla
Redirect 301 /seo-consultant-chilaw.html https://seoconsultantsrilanka.com/seo-consultant-puttalam
Redirect 301 /seo-consultant-chilaw https://seoconsultantsrilanka.com/seo-consultant-puttalam
Redirect 301 /seo-consultant-dehiwala-mount-lavinia.html https://seoconsultantsrilanka.com/seo-consultant-colombo
Redirect 301 /seo-consultant-dehiwala-mount-lavinia https://seoconsultantsrilanka.com/seo-consultant-colombo
Redirect 301 /seo-consultant-kalmunai.html https://seoconsultantsrilanka.com/seo-consultant-ampara
Redirect 301 /seo-consultant-kalmunai https://seoconsultantsrilanka.com/seo-consultant-ampara
Redirect 301 /seo-consultant-moratuwa.html https://seoconsultantsrilanka.com/seo-consultant-colombo
Redirect 301 /seo-consultant-moratuwa https://seoconsultantsrilanka.com/seo-consultant-colombo
Redirect 301 /seo-consultant-sri-jayawardenepura-kotte.html https://seoconsultantsrilanka.com/seo-consultant-colombo
Redirect 301 /seo-consultant-sri-jayawardenepura-kotte https://seoconsultantsrilanka.com/seo-consultant-colombo
Redirect 301 /seo-consultant-tangalle.html https://seoconsultantsrilanka.com/seo-consultant-hambantota
Redirect 301 /seo-consultant-tangalle https://seoconsultantsrilanka.com/seo-consultant-hambantota

# ================================================
# REMOVE .HTML EXTENSION FROM URLS
# ================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect external requests to non-extension version
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
    RewriteRule ^ %1 [R=301,L]

    # Internally rewrite non-extension requests to .html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^\.]+)$ $1.html [L]
</IfModule>

# ================================================
# CUSTOM ERROR PAGES
# ================================================
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# ================================================
# LEGACY SPACE-SLUG REDIRECTS (ported from web.config, never active on Apache)
# ================================================
<IfModule mod_rewrite.c>
    RewriteRule ^ai\ seo/?$ /ai-seo [R=301,L,NC]
    RewriteRule ^best\ seo\ company\ in\ sri\ lanka/?$ /seo-company-sri-lanka [R=301,L,NC]
    RewriteRule ^seo\ expert\ in\ srilanka/?$ /seo-expert-sri-lanka [R=301,L,NC]
    RewriteRule ^seo\ specialist\ sri\ lanka/?$ /seo-specialist-sri-lanka [R=301,L,NC]
    RewriteRule ^seo\ sri\ lanka/?$ /seo-sri-lanka [R=301,L,NC]
</IfModule>

# ================================================
# BASIC WAF (ported from web.config, never active on Apache)
# ================================================
<IfModule mod_rewrite.c>
    RewriteCond %{QUERY_STRING} (union|select|insert|update|delete|drop|create|alter|cast|execute|declare) [NC,OR]
    RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|etc/passwd|boot\.ini) [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# Block direct access to sensitive file types even if linked/discovered
<FilesMatch "\.(bak|backup|old|sql|log|env|config)$">
    Require all denied
</FilesMatch>

# ================================================
# BROWSER CACHING FOR PERFORMANCE
# ================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/x-javascript "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresDefault "access plus 7 days"
</IfModule>

# HTML pages must always revalidate so deploys show up immediately
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ================================================
# GZIP COMPRESSION
# ================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript
</IfModule>

# ================================================
# SECURITY HEADERS
# ================================================
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# ================================================
# FONT CACHING (previously fell through to 7-day default)
# ================================================
<IfModule mod_expires.c>
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
</IfModule>
