# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/webseo1/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/webseo1/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# ================================================
# WEBSITE CONFIGURATION FOR CPANEL
# ================================================

# Disable Directory Listing
Options -Indexes

# ================================================
# CUSTOM ERROR PAGES
# ================================================
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# ================================================
# BASIC WAF (ported from web.config, never active on Apache)
# ================================================
<IfModule mod_rewrite.c>
    RewriteCond %{QUERY_STRING} (union|select|insert|update|delete|drop|create|alter|cast|execute|declare) [NC,OR]
    RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|etc/passwd|boot\.ini) [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# ================================================
# MIGRATE PAGES TO SEOSERVICE.LK
# Exact destination paths below are present in the supplied sitemap.
# Unmatched page URLs are retired to the new homepage.
# ================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^$ https://seoservice.lk/ [R=301,L]
    RewriteRule ^(?:index(?:\.html)?)$ https://seoservice.lk/ [R=301,L]

    # Sitemap and crawler instructions belong to the destination site.
    RewriteRule ^(?:sitemap\.xml|assets/sitemap\.xml)$ https://seoservice.lk/sitemap.xml [R=301,L]
    RewriteRule ^robots\.txt$ https://seoservice.lk/robots.txt [R=301,L]

    # Legacy slugs that have a corresponding destination page.
    RewriteRule ^(?:best-seo-company-sri-lanka|seo-company-sri-lanka|seo-agency-sri-lanka)(?:\.html)?/?$ https://seoservice.lk/seo-company-sri-lanka [R=301,L]
    RewriteRule ^seo-price-in-sri-lanka(?:\.html)?/?$ https://seoservice.lk/seo-cost-sri-lanka [R=301,L]
    RewriteRule ^(?:ecommerce-seo-sri-lanka|ecommerce-seo)(?:\.html)?/?$ https://seoservice.lk/ecommerce-seo [R=301,L]
    RewriteRule ^local-seo-sri-lanka(?:\.html)?/?$ https://seoservice.lk/local-seo [R=301,L]
    RewriteRule ^on-page-seo-sri-lanka(?:\.html)?/?$ https://seoservice.lk/on-page-seo [R=301,L]
    RewriteRule ^technical-seo-sri-lanka(?:\.html)?/?$ https://seoservice.lk/technical-seo [R=301,L]
    RewriteRule ^seo-audit-sri-lanka(?:\.html)?/?$ https://seoservice.lk/seo-audits [R=301,L]
    RewriteRule ^google-maps-seo-sri-lanka(?:\.html)?/?$ https://seoservice.lk/google-map-pack-sri-lanka [R=301,L]
    RewriteRule ^seo-consultant-sri-lanka-guide(?:\.html)?/?$ https://seoservice.lk/seo-consultant-sri-lanka [R=301,L]
    RewriteRule ^how-to-become-seo-specialist(?:\.html)?/?$ https://seoservice.lk/how-to-become-an-seo-specialist-in-sri-lanka [R=301,L]
    RewriteRule ^seo-consultant-(colombo|gampaha|kalutara|kandy|galle|matara|jaffna|kurunegala)(?:\.html)?/?$ https://seoservice.lk/seo-services-$1 [R=301,L]
    RewriteRule ^seo-consultant-(dehiwala-mount-lavinia|moratuwa|sri-jayawardenepura-kotte)(?:\.html)?/?$ https://seoservice.lk/seo-services-colombo [R=301,L]
    RewriteRule ^seo-consultant-negombo(?:\.html)?/?$ https://seoservice.lk/seo-services-gampaha [R=301,L]

    # Keep every exact destination URL from the supplied sitemap on the same
    # path at the new domain, including requests that still use .html.
    RewriteRule ^(about|seo-consultant-sri-lanka|seo-specialist-sri-lanka|services|free-seo-checker|technical-seo|on-page-seo|off-page-seo|local-seo|ecommerce-seo|international-seo|seo-audits|keyword-research|seo-content-strategy|link-building|generative-engine-optimization|ai-search-optimization|chatgpt-visibility-optimization|google-ai-overview-optimization|perplexity-optimization|ai-citation-optimization|llm-content-optimization|ai-search-visibility-tracking|brand-entity-optimization|case-studies|customer-reviews|pricing|blog|seo-sri-lanka|contact|privacy-policy|terms|locations|google-seo)(?:\.html)?/?$ https://seoservice.lk/$1 [R=301,L]
    RewriteRule ^(possystem-lk-seo-case-study|gauraconstruction-lk-seo-case-study|lankatourdriver-com-seo-case-study|themerchlist-com-seo-case-study|mypalmfit-com-seo-case-study|tuktukceylonrides-com-seo-case-study|vapourzlounge-co-uk-seo-case-study)(?:\.html)?/?$ https://seoservice.lk/$1 [R=301,L]
    RewriteRule ^(google-algorithm-update-recovery|link-building-guide-2026|ecommerce-seo-checklist|title-tags-meta-descriptions-guide|international-seo-guide|how-to-rank-in-google-maps-colombo|core-web-vitals-guide|google-map-pack-sri-lanka|how-to-get-cited-in-chatgpt-perplexity-google-ai-overviews|how-google-ranking-works-for-sri-lankan-businesses|local-seo-outside-colombo-sri-lanka|seo-case-study-lessons-what-client-results-teach|how-to-target-uk-and-uae-customers-from-sri-lanka|seo-vs-google-ads|website-migration-seo-checklist|seo-content-calendar|seo-cost-sri-lanka|get-cited-by-ai-search|llms-txt-guide|sinhala-tamil-english-seo|schema-markup-guide)(?:\.html)?/?$ https://seoservice.lk/$1 [R=301,L]
    RewriteRule ^(seo-services-colombo|seo-services-gampaha|seo-services-kalutara|seo-services-kandy|seo-services-galle|seo-services-matara|seo-services-jaffna|seo-services-kurunegala|how-to-become-an-seo-specialist-in-sri-lanka)(?:\.html)?/?$ https://seoservice.lk/$1 [R=301,L]

    # Keep the configured local error documents available to Apache.
    RewriteRule ^(?:403|404|500)\.html$ - [L]

    # Static resources on this server are not page redirects.
    RewriteRule ^(?:assets/|\.well-known/).* - [L]

    # Any retired or unknown page URL has no destination in the new sitemap.
    RewriteRule ^ https://seoservice.lk/ [R=301,L]
</IfModule>

# Block direct access to sensitive file types even if linked/discovered
<FilesMatch "\.(bak|backup|old|sql|log|env|config)$">
    Require all denied
</FilesMatch>

# ================================================
# BROWSER CACHING FOR PERFORMANCE
# ================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/x-javascript "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresDefault "access plus 7 days"
</IfModule>

# HTML pages must always revalidate so deploys show up immediately
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ================================================
# GZIP COMPRESSION
# ================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript
</IfModule>

# ================================================
# SECURITY HEADERS
# ================================================
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# ================================================
# FONT CACHING (previously fell through to 7-day default)
# ================================================
<IfModule mod_expires.c>
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
</IfModule>
